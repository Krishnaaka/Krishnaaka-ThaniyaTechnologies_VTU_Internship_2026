# ═══════════════════════════════════════════
#  .env — ProjectIQ Backend Environment
#  NEVER commit this file to GitHub!
#  Copy this to .env and fill your values
# ═══════════════════════════════════════════

PORT=5000

# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/projectiq

# JWT Secret Key (make it long and random)
JWT_SECRET=projectiq_super_secret_jwt_key_2026_krishna_vtu

# JWT Expiry
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=development
